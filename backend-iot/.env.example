PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iot_db?schema=public
# Backend + Mosquitto trên cùng PC → mqtt://127.0.0.1:PORT (trùng listener trong mosquitto.conf).
# ESP32 phải dùng IP LAN của PC (ipconfig), không dùng 127.0.0.1.
MQTT_URL=mqtt://127.0.0.1:8000
MQTT_USERNAME=dinhvutrungduc
MQTT_PASSWORD=123456
MQTT_TOPIC_SENSOR=hw/sensor
MQTT_TOPIC_SENSOR_ERROR=hw/sensor/error
MQTT_TOPIC_CONTROL=hw/control
MQTT_TOPIC_FEEDBACK=hw/feedback
